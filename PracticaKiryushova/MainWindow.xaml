<Window x:Class="PracticaKiryushova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PracticaKiryushova"
        mc:Ignorable="d"
        Title="Работа с массивами" Height="800" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GroupBox Header="Исходный график" Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="dgFirst" Margin="5" CellEditEnding="dgFirst_CellEditEnding" />
                <Canvas x:Name="csFirst" Grid.Column="1" Margin="5" Height="270" Width="479"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Новый график" Grid.Row="2" Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="dgSecond" Margin="5" IsReadOnly="True" />
                <Canvas x:Name="csSecond" Grid.Column="1" Margin="5" Width="479" Height="270"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Работа с матрицей" Grid.Row="4" Grid.ColumnSpan="4" Margin="5" Background="#FFE8E8E8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">
                    <Label Content="Размер массива:"/>
                    <TextBox x:Name="tbSize" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="150" MaxLength="2" Margin="5"/>
                    <Button x:Name="btnCreate" Content="Создать" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Click="btnCreate_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="btnSwap" Content="Поменять местами Max и Min" Margin="5" Background="#FFC7CBE2" Click="btnSwap_Click"/>
                    <Button x:Name="btnClear" Content="Очистить значения" Margin="5" Click="btnClear_Click"/>
                    <Button x:Name="btnInfo" Content="Информация" Margin="5" Click="btnInfo_Click"/>
                    <Button x:Name="btnExit" Content="Выход" Margin="5" Background="#FFE69090" Click="btnExit_Click"/>
                </StackPanel>

            </Grid>    
        </GroupBox>
    </Grid>
</Window>
